<style>
  .customer-account {
    max-width: 460px;
    margin: 0 auto;
    padding: 56px 20px 80px;
    color: #252722;
  }
  .customer-account h1 {
    margin: 0 0 28px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2.5rem;
    font-weight: 400;
  }
  .customer-account form {
    display: grid;
    gap: 16px;
  }
  .customer-field label {
    display: block;
    margin-bottom: 7px;
    font-size: 0.9rem;
  }
  .customer-field input {
    width: 100%;
    min-height: 48px;
    padding: 10px 12px;
    border: 1px solid #dfe2da;
    border-radius: 6px;
    background: #fff;
    color: inherit;
    font: inherit;
  }
  .customer-button {
    min-height: 48px;
    padding: 10px 18px;
    border: 0;
    border-radius: 6px;
    background: #315c46;
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .customer-button:hover {
    background: #244735;
  }
  .customer-switch {
    margin-top: 24px;
    color: #72756f;
  }
  .customer-account a {
    color: #315c46;
  }
  .customer-error {
    padding: 12px;
    border-radius: 6px;
    background: #fff1ef;
    color: #8b2d20;
  }
  @media (max-width: 480px) {
    .customer-account {
      padding: 40px 18px 56px;
    }
  }
</style>
<main class="customer-account">
  <h1>Create account</h1>

  {% form 'create_customer' %}
    {% if form.errors %}
      <div class="customer-error" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}

    <div class="customer-field">
      <label for="FirstName">First name</label>
      <input id="FirstName" type="text" name="customer[first_name]" autocomplete="given-name">
    </div>

    <div class="customer-field">
      <label for="LastName">Last name</label>
      <input id="LastName" type="text" name="customer[last_name]" autocomplete="family-name">
    </div>

    <div class="customer-field">
      <label for="RegisterEmail">Email</label>
      <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
    </div>

    <div class="customer-field">
      <label for="RegisterPassword">Password</label>
      <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>

    <button class="customer-button" type="submit">Create account</button>
  {% endform %}

  <p class="customer-switch">Already have an account? <a href="{{ routes.account_login_url }}">Log in</a></p>
</main>
