{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "product-media": {
          "type": "media"
        },
        "product-title": {
          "type": "title"
        },
        "product-price": {
          "type": "price"
        },
        "variant-picker": {
          "type": "variant_picker",
          "settings": {
            "label": "Choose an option"
          }
        },
        "buy-buttons": {
          "type": "purchase",
          "settings": {
            "show_payment_button": true
          }
        },
        "product-description": {
          "type": "description"
        }
      },
      "block_order": [
        "product-media",
        "product-title",
        "product-price",
        "variant-picker",
        "buy-buttons",
        "product-description"
      ]
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "products_to_show": 4,
        "columns": 4,
        "corner_radius": 8,
        "padding_top": 48,
        "padding_bottom": 48,
        "background_color": "#ffffff",
        "card_color": "#ffffff",
        "text_color": "#252722",
        "border_color": "#e1e3dc"
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
