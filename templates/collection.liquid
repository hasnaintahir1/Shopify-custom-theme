<main class="products-page">
  <div class="products-heading">
    <h1>
      {% if collection.handle == 'all' %}All Products{% else %}{{ collection.title | escape }}{% endif %}
    </h1>
  </div>

  {% paginate collection.products by 12 %}
    <div class="products-grid">
      {% for product in collection.products %}
        <article class="product-card">
          <a href="{{ product.url }}">
            <div class="product-image">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </div>
            <h2>{{ product.title | escape }}</h2>
            <p>{{ product.price | money }}</p>
          </a>
        </article>
      {% else %}
        <p>No products found.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="products-pagination" aria-label="Product pages">
        {% if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">Previous</a>
        {%- endif %}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {% if paginate.next -%}
          <a href="{{ paginate.next.url }}">Next</a>
        {%- endif %}
      </nav>
    {% endif %}
  {% endpaginate %}
</main>

<style>
  .products-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 24px;
    color: #252722;
  }
  .products-heading {
    margin-bottom: 36px;
    padding: 34px 20px;
    border: 1px solid #d5e0d5;
    border-radius: 8px;
    background: #e8efe8;
    text-align: center;
  }
  .products-heading h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 28px 18px;
  }
  .product-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .product-card {
    overflow: hidden;
    border: 1px solid #e1e0da;
    border-radius: 8px;
    background: #fff;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px #25272218;
  }
  .product-card a:focus-visible {
    outline: 2px solid #526247;
    outline-offset: -3px;
  }
  .product-image {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #efeee8;
  }
  .product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }
  .product-card a:hover img {
    transform: scale(1.04);
  }
  .product-card h2 {
    margin: 0 0 6px;
    padding: 12px 12px 0;
    font-size: 0.95rem;
    font-weight: 400;
  }
  .product-card p {
    margin: 0;
    padding: 0 12px 14px;
    font-size: 0.9rem;
  }
  .products-pagination {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 36px;
  }
  .products-pagination a {
    color: inherit;
  }
  @media (max-width: 800px) {
    .products-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .products-page {
      padding: 36px 16px;
    }
    .products-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-image img,
    .product-card {
      transition: none;
    }
  }
</style>
