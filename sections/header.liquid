<style>
  .store-header {
    --header-ink: #20231f;
    --header-line: #e9e8e3;
    position: relative;
    z-index: 20;
    width: 100%;
    background: #fff;
    color: var(--header-ink);
    border-bottom: 1px solid var(--header-line);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .store-header__inner {
    max-width: 1440px;
    min-height: 82px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 28px;
  }
  .store-header__brand {
    grid-column: 1;
    display: inline-flex;
    align-items: center;
    justify-self: start;
    color: inherit;
    text-decoration: none;
  }
  .store-header__logo {
    display: block;
    width: auto;
    max-width: min(240px, 38vw);
    max-height: 54px;
    object-fit: contain;
  }
  .store-header__wordmark {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }
  .store-header__nav {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2.2vw, 34px);
  }
  .store-header__nav a,
  .store-header__mobile-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .store-header__nav a {
    padding: 12px 0;
  }
  .store-header__nav a:hover,
  .store-header__mobile-nav a:hover {
    opacity: 0.65;
  }
  .store-header__actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
  }
  .store-header__icon-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 32px;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    text-decoration: none;
    cursor: pointer;
  }
  .store-header__icon-button svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .store-header__cart-count {
    position: absolute;
    top: -2px;
    right: -8px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background: var(--header-ink);
    color: #fff;
    font-size: 10px;
    line-height: 1;
  }
  .store-header__mobile-menu {
    display: none;
  }
  .store-header__mobile-menu summary {
    list-style: none;
  }
  .store-header__mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .store-header__mobile-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 12px 24px 22px;
    display: grid;
    gap: 18px;
    background: #fff;
    border-bottom: 1px solid var(--header-line);
  }
  @media (max-width: 900px) {
    .store-header__inner {
      min-height: 72px;
      grid-template-columns: 1fr auto 1fr;
      gap: 12px;
      padding-inline: 22px;
    }
    .store-header__nav {
      display: none;
    }
    .store-header__mobile-menu {
      grid-column: 1;
      grid-row: 1;
      display: block;
      justify-self: start;
    }
    .store-header__brand {
      grid-column: 2;
      justify-self: center;
    }
    .store-header__actions {
      grid-column: 3;
      gap: 12px;
    }
  }
  @media (max-width: 480px) {
    .store-header__inner {
      min-height: 64px;
      padding-inline: 16px;
    }
    .store-header__logo {
      max-width: 38vw;
      max-height: 42px;
    }
    .store-header__actions {
      gap: 10px;
    }
  }
</style>
<header class="store-header" data-section-id="{{ section.id }}">
  <div class="store-header__inner">
    <details class="store-header__mobile-menu">
      <summary class="store-header__icon-button" aria-label="Open menu">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </summary>
      <nav class="store-header__mobile-nav" aria-label="Mobile navigation">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endfor %}
        {% endif %}
      </nav>
    </details>

    <a class="store-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {% if shop.brand.logo != blank %}
        {{
          shop.brand.logo
          | image_url: width: 500
          | image_tag: class: 'store-header__logo', widths: '120, 180, 250, 360, 500', alt: shop.name
        }}
      {% else %}
        <span class="store-header__wordmark">{{ shop.name | escape }}</span>
      {% endif %}
    </a>

    <nav class="store-header__nav" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        {% endfor %}
      {% endif %}
    </nav>

    <div class="store-header__actions">
      <a class="store-header__icon-button store-header__search" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 5 5" />
        </svg>
      </a>
      {% if shop.customer_accounts_enabled %}
        <a class="store-header__icon-button store-header__account" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8" r="3.5" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" />
          </svg>
        </a>
      {% endif %}
      <a
        class="store-header__icon-button store-header__cart"
        href="{{ routes.cart_url }}"
        aria-label="Cart, {{ cart.item_count }} items"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 4h2l2.1 11.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L21 8H6" /><circle cx="10" cy="21" r="1" /><circle cx="18" cy="21" r="1" />
        </svg>
        {% if cart.item_count > 0 -%}
          <span class="store-header__cart-count">{{ cart.item_count }}</span>
        {%- endif %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Store header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Store header"
    }
  ]
}
{% endschema %}
