<style>
  .cart-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 56px 24px 80px;
    color: #20211f;
  }
  .cart-page *,
  .cart-page *::before,
  .cart-page *::after {
    box-sizing: border-box;
  }
  .cart-heading {
    margin: 0 0 32px;
    padding: 28px 32px;
    border: 1px solid #dce5dc;
    border-radius: 8px;
    background: #edf3ed;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
  }
  .cart-heading span {
    color: #68756a;
    font-size: 0.65em;
    font-weight: 400;
  }
  .cart-empty {
    padding: 64px 24px;
    text-align: center;
    border: 1px solid #e7e8e4;
    border-radius: 8px;
    background: #fafbf9;
  }
  .cart-empty h2 {
    margin: 0 0 10px;
    font-size: 1.5rem;
  }
  .cart-empty p,
  .cart-caption {
    color: #72756f;
  }
  .cart-link,
  .cart-checkout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border: 0;
    border-radius: 8px;
    background: #315c46;
    color: #fff;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 180ms ease;
  }
  .cart-link:hover,
  .cart-checkout:hover {
    background: #244735;
  }
  .cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: start;
  }
  .cart-items {
    border-top: 1px solid #e7e8e4;
  }
  .cart-item {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid #e7e8e4;
  }
  .cart-item-image {
    display: block;
    width: 120px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: #f5f5f2;
  }
  .cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-item-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
  }
  .cart-item-title {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }
  .cart-item-meta,
  .cart-item-properties {
    color: #72756f;
    font-size: 0.9rem;
  }
  .cart-item-options {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .cart-item-option {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    padding: 5px 9px;
    border: 1px solid #dce5dc;
    border-radius: 999px;
    background: #f4f7f2;
    color: #315c46;
    font-size: 0.78rem;
    line-height: 1.25;
  }
  .cart-item-option__name {
    color: #72756f;
  }
  .cart-item-option__value {
    font-weight: 600;
  }
  .cart-item-properties p {
    margin: 3px 0;
  }
  .cart-item-price {
    white-space: nowrap;
    font-weight: 600;
  }
  .cart-quantity {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }
  .cart-quantity label {
    color: #72756f;
    font-size: 0.875rem;
  }
  .cart-quantity input {
    width: 68px;
    min-height: 40px;
    padding: 6px 10px;
    border: 1px solid #e7e8e4;
    border-radius: 7px;
    font: inherit;
  }
  .cart-remove {
    color: #72756f;
    font-size: 0.875rem;
    text-underline-offset: 3px;
  }
  .cart-summary {
    position: sticky;
    top: 24px;
    padding: 24px;
    border: 1px solid #dce5dc;
    border-radius: 8px;
    background: #f4f7f2;
  }
  .cart-summary h2 {
    margin: 0 0 20px;
    font-size: 1.25rem;
  }
  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid #e7e8e4;
    font-weight: 600;
  }
  .cart-caption {
    margin: 0 0 20px;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .cart-checkout {
    width: 100%;
  }
  .cart-update {
    margin-top: 14px;
    padding: 0;
    border: 0;
    background: none;
    color: #315c46;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .cart-update:hover,
  .cart-remove:hover {
    color: #244735;
  }
  .cart-error {
    margin: 0 0 18px;
    padding: 12px 14px;
    border-radius: 8px;
    background: #fff1ef;
    color: #8b2d20;
  }
  @media (max-width: 760px) {
    .cart-page {
      padding: 36px 18px 56px;
    }
    .cart-heading {
      padding: 22px 20px;
    }
    .cart-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .cart-summary {
      position: static;
    }
    .cart-item {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 14px;
    }
    .cart-item-image {
      width: 88px;
    }
    .cart-item-price {
      grid-column: 2;
    }
  }
</style>

<main class="cart-page">
  <h1 class="cart-heading">
    Your cart
    {%- if cart.item_count > 0 %}
      <span aria-label="{{ cart.item_count }} items">({{ cart.item_count }})</span>
    {%- endif %}
  </h1>

  {% if cart.item_count == 0 %}
    <section class="cart-empty">
      <h2>Your cart is empty</h2>
      <p>Looks like you haven’t found your favorites yet.</p>
      <a class="cart-link" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    </section>
  {% else %}
    {% form 'cart', cart, id: 'CartForm' %}
      {% if form.errors %}
        <div class="cart-error" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
      <div class="cart-layout">
        <section class="cart-items" aria-label="Items in your cart">
          {% for item in cart.items %}
            {% assign cart_item_image = item.image | default: item.variant.featured_image | default: item.product.featured_image %}
            <article class="cart-item">
              <a class="cart-item-image" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
                {% if cart_item_image -%}
                  <img
                    src="{{ cart_item_image | image_url: width: 300 }}"
                    alt="{{ cart_item_image.alt | default: item.product.title | escape }}"
                    width="120"
                    height="120"
                    loading="lazy"
                  >
                {%- endif %}
              </a>
              <div class="cart-item-details">
                <a class="cart-item-title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {% unless item.product.has_only_default_variant -%}
                  <div class="cart-item-options" aria-label="Selected options">
                    {% for option in item.options_with_values %}
                      <span class="cart-item-option">
                        <span class="cart-item-option__name">{{ option.name | escape }}</span>
                        <span class="cart-item-option__value">{{ option.value | escape }}</span>
                      </span>
                    {% endfor %}
                  </div>
                {%- endunless %}
                {% if item.selling_plan_allocation -%}
                  <span class="cart-item-meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</span>
                {%- endif %}
                {% if item.properties.size > 0 %}
                  <div class="cart-item-properties">
                    {% for property in item.properties %}
                      {% assign property_first_char = property.first | slice: 0 %}
                      {% if property.last != blank and property_first_char != '_' %}
                        <p>
                          {{ property.first | escape }}:
                          {% if property.last contains '/uploads/' -%}
                            <a href="{{ property.last }}">{{ property.last | split: '/' | last | escape }}</a>
                          {%- else -%}
                            {{- property.last | escape -}}
                          {%- endif %}
                        </p>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
                <div class="cart-quantity">
                  <label for="CartQuantity-{{ forloop.index }}">Qty</label>
                  <input
                    id="CartQuantity-{{ forloop.index }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="Quantity for {{ item.product.title | escape }}"
                  >
                  <a class="cart-remove" href="{{ item.url_to_remove }}">Remove</a>
                </div>
              </div>
              <div class="cart-item-price">{{ item.final_line_price | money }}</div>
            </article>
          {% endfor %}
          <button class="cart-update" type="submit" name="update">Update cart</button>
        </section>
        <aside class="cart-summary" aria-label="Order summary">
          <h2>Order summary</h2>
          <div class="cart-subtotal">
            <span>Subtotal</span><span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-caption">Taxes and shipping are calculated at checkout.</p>
          <button class="cart-checkout" type="submit" name="checkout">Proceed to checkout</button>
        </aside>
      </div>
    {% endform %}
  {% endif %}
</main>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
