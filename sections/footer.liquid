{% style %}
  #StoreFooter-{{ section.id }} {
    --footer-background: {{ section.settings.background_color }};
    --footer-surface: {{ section.settings.surface_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-muted: {{ section.settings.muted_color }};
    --footer-accent: {{ section.settings.accent_color }};
    --footer-border: {{ section.settings.border_color }};
    --footer-radius: {{ section.settings.corner_radius }}px;
    color: var(--footer-text);
    background: var(--footer-background);
  }

  #StoreFooter-{{ section.id }} a {
    color: inherit;
  }

  #StoreFooter-{{ section.id }} .store-footer__inner {
    width: calc(100% - 48px);
    max-width: 1440px;
    margin-inline: auto;
    padding-block: {{ section.settings.padding_top }}px 24px;
  }

  #StoreFooter-{{ section.id }} .store-footer__top {
    display: grid;
    grid-template-columns: minmax(240px, 1.1fr) minmax(320px, 0.9fr);
    gap: clamp(36px, 8vw, 120px);
    align-items: start;
    padding-bottom: 52px;
  }

  #StoreFooter-{{ section.id }} .store-footer__brand {
    max-width: 470px;
  }

  #StoreFooter-{{ section.id }} .store-footer__logo {
    display: block;
    width: auto;
    max-width: min(220px, 100%);
    max-height: 72px;
    object-fit: contain;
    object-position: left center;
  }

  #StoreFooter-{{ section.id }} .store-footer__brand-name {
    display: inline-block;
    color: var(--footer-text);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #StoreFooter-{{ section.id }} .store-footer__description {
    max-width: 420px;
    margin: 16px 0 0;
    color: var(--footer-muted);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  #StoreFooter-{{ section.id }} .store-footer__newsletter {
    padding: 26px;
    border: 1px solid var(--footer-border);
    border-radius: var(--footer-radius);
    background: var(--footer-surface);
  }

  #StoreFooter-{{ section.id }} .store-footer__newsletter-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  #StoreFooter-{{ section.id }} .store-footer__newsletter-copy {
    margin: 8px 0 18px;
    color: var(--footer-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  #StoreFooter-{{ section.id }} .store-footer__form {
    display: flex;
    gap: 8px;
  }

  #StoreFooter-{{ section.id }} .store-footer__email {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--footer-border);
    border-radius: max(4px, calc(var(--footer-radius) / 2));
    background: var(--footer-background);
    color: var(--footer-text);
    font: inherit;
  }

  #StoreFooter-{{ section.id }} .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #StoreFooter-{{ section.id }} .store-footer__email::placeholder {
    color: var(--footer-muted);
    opacity: 0.85;
  }

  #StoreFooter-{{ section.id }} .store-footer__submit {
    flex: 0 0 auto;
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid var(--footer-accent);
    border-radius: max(4px, calc(var(--footer-radius) / 2));
    background: var(--footer-accent);
    color: #fff;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 160ms ease;
  }

  #StoreFooter-{{ section.id }} .store-footer__submit:hover {
    opacity: 0.86;
  }

  #StoreFooter-{{ section.id }} .store-footer__form-message {
    margin: 12px 0 0;
    color: var(--footer-muted);
    font-size: 0.86rem;
  }

  #StoreFooter-{{ section.id }} .store-footer__form-message--error {
    color: #c34545;
  }

  #StoreFooter-{{ section.id }} .store-footer__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-block: 34px 40px;
    border-top: 1px solid var(--footer-border);
  }

  #StoreFooter-{{ section.id }} .store-footer__menu-title {
    margin: 0 0 18px;
    color: var(--footer-text);
    font-size: 0.9rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  #StoreFooter-{{ section.id }} .store-footer__menu-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #StoreFooter-{{ section.id }} .store-footer__menu-link {
    color: var(--footer-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 160ms ease;
  }

  #StoreFooter-{{ section.id }} .store-footer__menu-link:hover {
    color: var(--footer-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #StoreFooter-{{ section.id }} .store-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 22px;
    border-top: 1px solid var(--footer-border);
  }

  #StoreFooter-{{ section.id }} .store-footer__copyright {
    margin: 0;
    color: var(--footer-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  #StoreFooter-{{ section.id }} .store-footer__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  #StoreFooter-{{ section.id }} .store-footer__social-link {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--footer-border);
    border-radius: 50%;
    color: var(--footer-text);
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }

  #StoreFooter-{{ section.id }} .store-footer__social-link:hover {
    border-color: var(--footer-accent);
    background: var(--footer-accent);
    color: #fff;
  }

  #StoreFooter-{{ section.id }} .store-footer__social-link svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  #StoreFooter-{{ section.id }} .store-footer__payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
  }

  #StoreFooter-{{ section.id }} .store-footer__payment {
    display: block;
    width: 38px;
    height: auto;
  }

  #StoreFooter-{{ section.id }} .store-footer__payment svg {
    display: block;
    width: 100%;
    height: auto;
  }

  #StoreFooter-{{ section.id }} .store-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  #StoreFooter-{{ section.id }} .store-footer__legal a {
    color: var(--footer-muted);
    font-size: 0.76rem;
    text-decoration: none;
  }

  #StoreFooter-{{ section.id }} .store-footer__legal a:hover {
    color: var(--footer-text);
    text-decoration: underline;
  }

  @media screen and (max-width: 900px) {
    #StoreFooter-{{ section.id }} .store-footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media screen and (max-width: 749px) {
    #StoreFooter-{{ section.id }} .store-footer__inner {
      width: calc(100% - 36px);
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
    }

    #StoreFooter-{{ section.id }} .store-footer__top {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 34px;
    }

    #StoreFooter-{{ section.id }} .store-footer__newsletter {
      padding: 20px;
    }

    #StoreFooter-{{ section.id }} .store-footer__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
      padding-block: 28px 32px;
    }

    #StoreFooter-{{ section.id }} .store-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }
  }

  @media screen and (max-width: 420px) {
    #StoreFooter-{{ section.id }} .store-footer__form {
      flex-direction: column;
    }

    #StoreFooter-{{ section.id }} .store-footer__submit {
      width: 100%;
    }

    #StoreFooter-{{ section.id }} .store-footer__links {
      grid-template-columns: 1fr 1fr;
      gap: 24px 14px;
    }
  }
{% endstyle %}

<footer
  id="StoreFooter-{{ section.id }}"
  class="store-footer"
>
  <div class="store-footer__inner">
    <div class="store-footer__top">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'brand' %}
            <div class="store-footer__brand" {{ block.shopify_attributes }}>
              <a class="store-footer__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
                {% if block.settings.logo != blank %}
                  {{
                    block.settings.logo
                    | image_url: width: 600
                    | image_tag:
                      class: 'store-footer__logo',
                      loading: 'lazy',
                      widths: '160, 240, 360, 480, 600',
                      alt: block.settings.logo.alt
                  }}
                {% else %}
                  <span class="store-footer__brand-name">{{ block.settings.brand_name | default: shop.name | escape }}</span>
                {% endif %}
              </a>

              {% if block.settings.description != blank %}
                <p class="store-footer__description">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          {% when 'newsletter' %}
            <div class="store-footer__newsletter" {{ block.shopify_attributes }}>
              <h2 class="store-footer__newsletter-title">{{ block.settings.heading | escape }}</h2>
              {% if block.settings.description != blank %}
                <p class="store-footer__newsletter-copy">{{ block.settings.description | escape }}</p>
              {% endif %}

              {% form 'customer', class: 'store-footer__customer-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="store-footer__form">
                  <label class="visually-hidden" for="FooterEmail-{{ section.id }}-{{ block.id }}">Email address</label>
                  <input
                    id="FooterEmail-{{ section.id }}-{{ block.id }}"
                    class="store-footer__email"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ block.settings.email_placeholder | escape }}"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    required
                  >
                  <button class="store-footer__submit" type="submit">
                    {{ block.settings.button_label | escape }}
                  </button>
                </div>

                {% if form.posted_successfully? %}
                  <p class="store-footer__form-message" role="status">{{ block.settings.success_message | escape }}</p>
                {% elsif form.errors %}
                  <div class="store-footer__form-message store-footer__form-message--error" role="alert">
                    {{ form.errors | default_errors }}
                  </div>
                {% endif %}
              {% endform %}
            </div>
          {% when '@app' %}
            {% render block %}
        {% endcase %}
      {% endfor %}
    </div>

    {% assign footer_menu_blocks = section.blocks | where: 'type', 'menu' %}
    {% if footer_menu_blocks.size > 0 %}
      <div class="store-footer__links">
        {% for block in footer_menu_blocks %}
          <nav class="store-footer__menu" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h2 class="store-footer__menu-title">{{ block.settings.heading | escape }}</h2>
            {% endif %}

            {% if block.settings.menu != blank %}
              <ul class="store-footer__menu-list">
                {% for link in block.settings.menu.links %}
                  <li>
                    <a class="store-footer__menu-link" href="{{ link.url }}">
                      {{ link.title | escape }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </nav>
        {% endfor %}
      </div>
    {% endif %}

    <div class="store-footer__bottom">
      {% assign social_blocks = section.blocks | where: 'type', 'social' %}
      {% if social_blocks.size > 0 %}
        <div class="store-footer__socials" aria-label="Social media">
          {% for block in social_blocks %}
            {% if block.settings.url != blank %}
              {% assign social_name = block.settings.platform %}
              <a class="store-footer__social-link" href="{{ block.settings.url }}" aria-label="{{ social_name | escape }}" rel="noopener" {{ block.shopify_attributes }}>
                {% case social_name %}
                  {% when 'Instagram' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <path d="M17.5 6.5h.01" />
                    </svg>
                  {% when 'Facebook' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M14 21v-8h3l.5-4H14V7c0-1.2.4-2 2-2h2V1.4c-.8-.1-1.8-.2-3-.2-3.1 0-5 1.9-5 5.3V9H7v4h3v8" />
                    </svg>
                  {% when 'TikTok' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M14 3v11.2a4.2 4.2 0 1 1-3.2-4.1M14 3c.5 3 2.2 4.8 5 5" />
                    </svg>
                  {% when 'YouTube' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="2" y="5" width="20" height="14" rx="4" />
                      <path d="m10 9 5 3-5 3z" />
                    </svg>
                  {% when 'Pinterest' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 21a9 9 0 1 0-3.7-.8l1.2-4.8M9.5 11c0-2 1.2-3.5 3.1-3.5 1.6 0 2.7 1.1 2.7 2.7 0 2.2-1 4.4-2.8 4.4-1 0-1.8-.9-1.5-2l.7-2.8" />
                    </svg>
                {% endcase %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'copyright' %}
            <p class="store-footer__copyright" {{ block.shopify_attributes }}>
              &copy; {{ 'now' | date: '%Y' }}
              {{ block.settings.brand_name | default: shop.name | escape }}.
              {{ block.settings.text | escape }}
            </p>
          {% when 'payments' %}
            {% if shop.enabled_payment_types.size > 0 %}
              <div class="store-footer__payments" aria-label="Accepted payment methods" {{ block.shopify_attributes }}>
                {% for type in shop.enabled_payment_types %}
                  <span class="store-footer__payment">{{ type | payment_type_svg_tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
          {% when 'policies' %}
            <nav class="store-footer__legal" aria-label="Policies" {{ block.shopify_attributes }}>
              {% if shop.privacy_policy != blank %}
                <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>
              {% endif %}
              {% if shop.refund_policy != blank %}
                <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a>
              {% endif %}
              {% if shop.shipping_policy != blank %}
                <a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a>
              {% endif %}
              {% if shop.terms_of_service != blank %}
                <a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a>
              {% endif %}
            </nav>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Store footer",
  "tag": "section",
  "class": "section-store-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 50,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Footer background",
      "default": "#111512"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Newsletter panel background",
      "default": "#1b211d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text color",
      "default": "#f6f5f0"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text color",
      "default": "#b7beb7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#526b55"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#343b35"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "Corner radius"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72,
      "label": "Top spacing"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Footer logo"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Thoughtfully selected essentials, made to bring a little more joy to every day."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter signup",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A little good news"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Sign up for new arrivals, thoughtful updates, and 10% off your first order."
        },
        {
          "type": "text",
          "id": "email_placeholder",
          "label": "Email placeholder",
          "default": "Your email address"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Subscribe"
        },
        {
          "type": "text",
          "id": "success_message",
          "label": "Success message",
          "default": "Thanks for subscribing!"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Footer menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Menu heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            { "value": "Instagram", "label": "Instagram" },
            { "value": "Facebook", "label": "Facebook" },
            { "value": "TikTok", "label": "TikTok" },
            { "value": "YouTube", "label": "YouTube" },
            { "value": "Pinterest", "label": "Pinterest" }
          ],
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    },
    {
      "type": "payments",
      "name": "Payment icons"
    },
    {
      "type": "policies",
      "name": "Policy links"
    },
    {
      "type": "copyright",
      "name": "Copyright",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Copyright text",
          "default": "All rights reserved."
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Store footer",
      "category": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "newsletter" },
        { "type": "menu", "settings": { "heading": "Explore" } },
        { "type": "menu", "settings": { "heading": "Customer care" } },
        { "type": "menu", "settings": { "heading": "About us" } },
        { "type": "copyright" },
        { "type": "payments" },
        { "type": "policies" }
      ]
    }
  ]
}
{% endschema %}
