<style>
  #FeaturedCollection-{{ section.id }} {
    --fc-ink: #20251f;
    --fc-muted: #73796f;
    --fc-accent: #52664f;
    --fc-surface: #f5f5f0;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: var(--fc-ink);
    background: {{ section.settings.background_color }};
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__title {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.12;
    letter-spacing: -.04em;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__view-all {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    color: var(--fc-ink);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition: color .2s ease;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__view-all:hover {
    color: var(--fc-accent);
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--fc-columns), minmax(0, 1fr));
    gap: 28px 20px;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__card {
    min-width: 0;
    box-sizing: border-box;
    border: 1px solid #e5e5e5;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--fc-surface);
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .55s cubic-bezier(.2, .7, .2, 1);
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__card:hover .featured-collection__image {
    transform: scale(1.04);
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__placeholder {
    width: 100%;
    height: 100%;
    fill: #dfe2d9;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 7px 10px;
    background: #fff;
    color: var(--fc-ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__details {
    padding: 13px;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__vendor {
    margin: 0 0 5px;
    color: var(--fc-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__product-title {
    margin: 0;
    font-size: 14px;
    font-weight: 550;
    line-height: 1.4;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__product-title a {
    color: inherit;
    text-decoration: none;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__product-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: 7px;
    font-size: 13px;
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__from,
  #FeaturedCollection-{{ section.id }} .featured-collection__compare-price {
    color: var(--fc-muted);
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__empty {
    min-height: 40px;
    color: var(--fc-muted);
  }
  #FeaturedCollection-{{ section.id }} .featured-collection__empty p {
    margin: 0;
    padding: 28px;
    background: var(--fc-surface);
    text-align: center;
  }
  @media (max-width: 989px) {
    #FeaturedCollection-{{ section.id }} .featured-collection__inner {
      padding: 0 24px;
    }
    #FeaturedCollection-{{ section.id }} .featured-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px 14px;
    }
  }
  @media (max-width: 600px) {
    #FeaturedCollection-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }
    #FeaturedCollection-{{ section.id }} .featured-collection__inner {
      padding: 0 18px;
    }
    #FeaturedCollection-{{ section.id }} .featured-collection__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 22px;
    }
  }
</style>
{%- liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.products_to_show
-%}

<section class="featured-collection" id="FeaturedCollection-{{ section.id }}">
  <div class="featured-collection__inner page-width">
    <div class="featured-collection__header">
      <h2 class="featured-collection__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.show_view_all
        and featured_collection != blank
        and featured_collection.products_count > 0
      -%}
        <a class="featured-collection__view-all" href="{{ featured_collection.url }}">
          {{ section.settings.view_all_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      <div class="featured-collection__grid" style="--fc-columns: {{ section.settings.columns }};">
        {%- for product in featured_collection.products limit: product_limit -%}
          <article class="featured-collection__card">
            <a
              class="featured-collection__image-link"
              href="{{ product.url }}"
              aria-label="{{ product.title | escape }}"
            >
              <div class="featured-collection__image-wrap">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media.preview_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'featured-collection__image',
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                      alt: product.featured_media.alt
                    | default: product.title
                    | escape
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'featured-collection__placeholder' }}
                {%- endif -%}
              </div>
            </a>
            <div class="featured-collection__details">
              <h3 class="featured-collection__product-title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>
              <div class="featured-collection__price">
                <span>{{ product.price | money }}</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="featured-collection__empty">
        {%- if request.design_mode -%}
          <p>Select a collection in this section’s settings to show products here.</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>


{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "default": 4, "label": "Desktop columns" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "Shop the collection" },
    { "type": "text", "id": "sale_label", "label": "Sale badge label", "default": "Sale" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "default": 64, "label": "Top padding" },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "label": "Bottom padding"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
