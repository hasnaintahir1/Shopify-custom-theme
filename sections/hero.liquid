<style>
  .hero-section {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }
  .hero-section__inner {
    display: flex;
    align-items: center;
    gap: 6%;
  }
  .hero-section__content {
    width: 44%;
    max-width: 590px;
  }
  .hero-section__visual {
    width: 50%;
    height: 500px;
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
    position: relative;
  }
  .hero-section--background {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    min-height: 620px;
    position: relative;
  }
  .hero-section--background.hero-section--small { min-height: 380px; }
  .hero-section--background.hero-section--large { min-height: 620px; }
  .hero-section--background.hero-section--fullscreen {
    min-height: 100vh;
    min-height: 100svh;
  }
  .hero-section--background .hero-section__inner {
    position: static;
    width: 100%;
  }
  .hero-section--background .hero-section__content {
    position: relative;
    width: 60%;
    max-width: 720px;
    z-index: 2;
  }
  .hero-section--background.hero-section--text-center .hero-section__content {
    margin-left: auto;
    margin-right: auto;
  }
  .hero-section--background.hero-section--text-right .hero-section__content {
    margin-left: auto;
  }
  .hero-section--background.hero-section--text-left .hero-section__content {
    margin-right: auto;
  }
  .hero-section--background .hero-section__visual {
    border-radius: 0;
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
    z-index: 0;
  }
  .hero-section--background .hero-section__image {
    opacity: 1;
  }
  .hero-section__soft-overlay {
    background: rgba(255, 255, 255, 0.18);
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }
  .hero-section--background .hero-section__placeholder {
    background: linear-gradient(115deg, #f7f5f0, #ebe7df 55%, #f5f2ec);
  }
  .hero-section--left .hero-section__visual { order: -1; }
  .hero-section__content--center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-section__eyebrow {
    color: {{ section.settings.accent_color }};
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.4;
    margin: 0 0 18px;
    text-transform: uppercase;
  }
  .hero-section__heading {
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0;
    max-width: 12em;
  }
  .hero-section__description {
    font-size: 1rem;
    line-height: 1.7;
    margin-top: 23px;
    max-width: 48em;
  }
  .hero-section__description p { margin: 0 0 0.75em; }
  .hero-section__description p:last-child { margin-bottom: 0; }
  .hero-section__button {
    align-items: center;
    background: {{ section.settings.button_color }};
    border-radius: 30px;
    color: {{ section.settings.button_text_color }};
    cursor: pointer;
    display: inline-flex;
    font-size: 0.95rem;
    font-weight: 700;
    gap: 12px;
    justify-content: center;
    margin-top: 31px;
    height: {{ section.settings.button_height }}px;
    width: {{ section.settings.button_width }}px;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0 12px;
    text-align: center;
    text-decoration: none;
  }
  .hero-section__button span {
    font-size: 1.25rem;
    line-height: 1;
  }
  .hero-section__image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .hero-section__placeholder { background: #f2f2f2; }
  .hero-section__image-overlay {
    background: #000;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    opacity: {{ section.settings.image_overlay | divided_by: 100.0 }};
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }
  .hero-section__caption {
    bottom: 24px;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    left: 25px;
    position: absolute;
    z-index: 2;
  }

  @media screen and (max-width: 749px) {
    .hero-section {
      padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
    }
    .hero-section__inner {
      flex-direction: column;
      gap: 30px;
    }
    .hero-section--left .hero-section__visual { order: 0; }
    .hero-section__content,
    .hero-section__visual {
      width: 100%;
      max-width: none;
    }
    .hero-section__heading {
      font-size: {{ section.settings.heading_size | times: 0.7 | round }}px;
    }
    .hero-section__visual { height: 340px; }
    .hero-section--background {
      min-height: 0;
      padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
    }
    .hero-section--background.hero-section--small { min-height: 380px; }
    .hero-section--background.hero-section--large { min-height: 620px; }
    .hero-section--background.hero-section--fullscreen {
      min-height: 100vh;
      min-height: 100svh;
    }
    .hero-section--background .hero-section__inner {
      flex-direction: row;
    }
    .hero-section--background .hero-section__content {
      width: 100%;
    }
  }
</style>

{% liquid
  assign hero_image = section.settings.image
  assign image_alt = hero_image.alt | default: section.settings.heading | escape
  if section.settings.layout == 'background'
    assign image_sizes = '100vw'
  else
    assign image_sizes = '(min-width: 990px) 50vw, 100vw'
  endif
%}

<section
  id="Hero-{{ section.id }}"
  class="hero-section hero-section--{{ section.settings.layout }}{% if section.settings.layout == 'split' %} hero-section--{{ section.settings.image_position }}{% endif %}{% if section.settings.layout == 'background' %} hero-section--{{ section.settings.background_height }} hero-section--text-{{ section.settings.text_position }}{% endif %}"
>
  <div class="hero-section__inner page-width">
    <div class="hero-section__content hero-section__content--{{ section.settings.text_alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="hero-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-section__heading">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hero-section__description">{{ section.settings.description }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="hero-section__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    <div class="hero-section__visual">
      {% if hero_image != blank %}
        {{
          hero_image
          | image_url: width: 1800
          | image_tag:
            class: 'hero-section__image',
            widths: '500, 700, 900, 1200, 1500, 1800',
            sizes: image_sizes,
            loading: 'eager',
            alt: image_alt
        }}
      {% else %}
        <div class="hero-section__image hero-section__placeholder" aria-hidden="true"></div>
      {% endif %}
      {% if section.settings.layout == 'background' %}
        <span class="hero-section__soft-overlay" aria-hidden="true"></span>
      {% endif %}
      {% if section.settings.show_image_overlay -%}
        <span class="hero-section__image-overlay" aria-hidden="true"></span>
      {%- endif %}
      {% if section.settings.image_caption != blank %}
        <div class="hero-section__caption">{{ section.settings.image_caption | escape }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "class": "section-editorial-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A little something special" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Everyday, made extraordinary." },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtful essentials designed to bring a little more joy to the everyday.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    {
      "type": "select",
      "id": "layout",
      "label": "Hero layout",
      "options": [
        { "value": "background", "label": "Full-width background" },
        { "value": "split", "label": "Split image and text" }
      ],
      "default": "background"
    },
    {
      "type": "select",
      "id": "background_height",
      "label": "Background hero height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "large", "label": "Large" },
        { "value": "fullscreen", "label": "Full screen" }
      ],
      "default": "large"
    },
    { "type": "text", "id": "image_caption", "label": "Image caption" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Background text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_image_overlay", "label": "Show image overlay", "default": false },
    {
      "type": "range",
      "id": "button_width",
      "label": "Button width",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height",
      "min": 44,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "image_overlay",
      "label": "Image overlay strength",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 48,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4F0E9" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#20231F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#7C6548" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#20231F" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "category": "Banners"
    }
  ]
}
{% endschema %}
