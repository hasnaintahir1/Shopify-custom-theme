{% style %}
  #StoreBenefits-{{ section.id }} {
    --benefits-columns: {{ section.settings.columns }};
    --benefits-mobile-columns: {{ section.settings.mobile_columns }};
    --benefits-gap: {{ section.settings.card_gap }}px;
    --benefits-radius: {{ section.settings.card_radius }}px;
    --benefits-icon-size: {{ section.settings.icon_size }}px;
    --benefits-background: {{ section.settings.background_color }};
    --benefits-card-background: {{ section.settings.card_background }};
    --benefits-text: {{ section.settings.text_color }};
    --benefits-muted: {{ section.settings.description_color }};
    --benefits-icon: {{ section.settings.icon_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    background: var(--benefits-background);
  }

  #StoreBenefits-{{ section.id }} .store-benefits__inner {
    width: calc(100% - 40px);
    max-width: {{ section.settings.max_width }}px;
    margin-inline: auto;
  }

  #StoreBenefits-{{ section.id }} .store-benefits__heading {
    margin: 0 0 24px;
    color: var(--benefits-text);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-align: {{ section.settings.heading_alignment }};
  }

  #StoreBenefits-{{ section.id }} .store-benefits__grid {
    display: grid;
    grid-template-columns: repeat(var(--benefits-columns), minmax(0, 1fr));
    gap: var(--benefits-gap);
  }

  #StoreBenefits-{{ section.id }} .store-benefits__card {
    display: flex;
    min-width: 0;
    min-height: {{ section.settings.card_height }}px;
    align-items: flex-start;
    gap: 14px;
    padding: 20px 18px;
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: var(--benefits-radius);
    background: var(--benefits-card-background);
    color: var(--benefits-text);
  }

  #StoreBenefits-{{ section.id }} .store-benefits__icon {
    display: grid;
    flex: 0 0 var(--benefits-icon-size);
    width: var(--benefits-icon-size);
    height: var(--benefits-icon-size);
    margin-top: 1px;
    place-items: center;
    color: var(--benefits-icon);
  }

  #StoreBenefits-{{ section.id }} .store-benefits__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  #StoreBenefits-{{ section.id }} .store-benefits__copy {
    min-width: 0;
  }

  #StoreBenefits-{{ section.id }} .store-benefits__title {
    margin: 0;
    color: var(--benefits-text);
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.35;
  }

  #StoreBenefits-{{ section.id }} .store-benefits__description {
    margin: 5px 0 0;
    color: var(--benefits-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media screen and (max-width: 989px) {
    #StoreBenefits-{{ section.id }} .store-benefits__grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #StoreBenefits-{{ section.id }} {
      padding-block: {{ section.settings.padding_top | times: 0.7 | round }}px {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }

    #StoreBenefits-{{ section.id }} .store-benefits__inner {
      width: calc(100% - 32px);
    }

    #StoreBenefits-{{ section.id }} .store-benefits__heading {
      margin-bottom: 18px;
    }

    #StoreBenefits-{{ section.id }} .store-benefits__grid {
      grid-template-columns: repeat(var(--benefits-mobile-columns), minmax(0, 1fr));
      gap: max(10px, calc(var(--benefits-gap) * 0.7));
    }

    #StoreBenefits-{{ section.id }} .store-benefits__card {
      min-height: 0;
      gap: 11px;
      padding: 16px 14px;
    }

    #StoreBenefits-{{ section.id }} .store-benefits__title {
      font-size: 0.88rem;
    }

    #StoreBenefits-{{ section.id }} .store-benefits__description {
      font-size: 0.76rem;
    }
  }

  @media screen and (max-width: 380px) {
    #StoreBenefits-{{ section.id }} .store-benefits__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<section id="StoreBenefits-{{ section.id }}" class="store-benefits">
  <div class="store-benefits__inner">
    {% if section.settings.heading != blank %}
      <h2 class="store-benefits__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="store-benefits__grid">
        {% for block in section.blocks %}
          <article class="store-benefits__card" {{ block.shopify_attributes }}>
            <span class="store-benefits__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'shipping' %}
                  <svg viewBox="0 0 24 24">
                    <path d="M3 7h11v11H3zM14 11h4l3 3v4h-7z" />
                    <circle cx="7.5" cy="18" r="2" />
                    <circle cx="18" cy="18" r="2" />
                    <path d="M17 11v4h4M6 10h5M6 13h3" />
                  </svg>
                {% when 'returns' %}
                  <svg viewBox="0 0 24 24">
                    <path d="M4 11a8 8 0 1 1 1 6" />
                    <path d="M4 5v6h6M12 7v5l3 2" />
                  </svg>
                {% when 'secure' %}
                  <svg viewBox="0 0 24 24">
                    <rect x="5" y="10" width="14" height="11" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
                  </svg>
                {% when 'quality' %}
                  <svg viewBox="0 0 24 24">
                    <path d="m12 3 2.7 2 3.4-.1.8 3.3 2.1 2.6-1.4 3.1.4 3.4-3.1 1.4-2.2 2.6-3.3-.8-3.3.8-2.2-2.6-3.1-1.4.4-3.4-1.4-3.1 2.1-2.6.8-3.3 3.4.1z" />
                    <path d="m8.5 12 2.2 2.2 4.8-4.8" />
                  </svg>
                {% when 'support' %}
                  <svg viewBox="0 0 24 24">
                    <path d="M4 13v-2a8 8 0 0 1 16 0v2" />
                    <rect x="3" y="12" width="4" height="7" rx="2" />
                    <rect x="17" y="12" width="4" height="7" rx="2" />
                    <path d="M17 19a4 4 0 0 1-4 3h-1" />
                  </svg>
                {% when 'gift' %}
                  <svg viewBox="0 0 24 24">
                    <path d="M3 10h18v11H3zM2 6h20v4H2zM12 6v15" />
                    <path d="M12 6H8.5a2.5 2.5 0 1 1 2.5-2.5V6Zm0 0h3.5A2.5 2.5 0 1 0 13 3.5V6Z" />
                  </svg>
                {% when 'eco' %}
                  <svg viewBox="0 0 24 24">
                    <path d="M20 4c-8 0-14 3-14 10a6 6 0 0 0 6 6c7 0 10-8 8-16Z" />
                    <path d="M4 21c3-5 7-8 12-11" />
                  </svg>
                {% else %}
                  <svg viewBox="0 0 24 24">
                    <path d="M12 3 3 7.5l9 4.5 9-4.5L12 3Z" />
                    <path d="m3 12 9 4.5 9-4.5M3 16.5 12 21l9-4.5" />
                  </svg>
              {% endcase %}
            </span>

            <div class="store-benefits__copy">
              {% if block.settings.title != blank %}
                <h3 class="store-benefits__title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="store-benefits__description">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Store benefits",
  "tag": "section",
  "class": "section-store-benefits",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Cards per row on desktop"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Cards per row on mobile",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1400,
      "label": "Maximum content width"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "Space between cards"
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 72,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96,
      "label": "Minimum card height"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10,
      "label": "Card corner radius"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 18,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24,
      "label": "Icon size"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#080808"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#292929"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading and title color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#d0d0d0"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Top spacing"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Bottom spacing"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shipping",
          "options": [
            { "value": "shipping", "label": "Fast shipping" },
            { "value": "returns", "label": "Easy returns" },
            { "value": "secure", "label": "Secure payments" },
            { "value": "quality", "label": "Premium quality" },
            { "value": "support", "label": "Customer support" },
            { "value": "gift", "label": "Gift" },
            { "value": "eco", "label": "Eco friendly" },
            { "value": "package", "label": "Package" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast Shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Quick and reliable delivery to your doorstep."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store benefits",
      "category": "Content",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "title": "Fast Shipping",
            "description": "Quick and reliable delivery to your doorstep."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "returns",
            "title": "Easy Returns",
            "description": "Hassle-free returns within our return policy."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "secure",
            "title": "Secure Payments",
            "description": "Your payment information is safe and protected."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "quality",
            "title": "Premium Quality",
            "description": "High-quality products made for long-lasting use."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "title": "Customer Support",
            "description": "Friendly support whenever you need assistance."
          }
        }
      ]
    }
  ]
}
{% endschema %}
